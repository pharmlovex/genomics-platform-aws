manifest {
    name            = 'bam-qc'
    description     = 'Mapped-read concordance (samtools flagstat vs idxstats) on any executor'
    nextflowVersion = '>=24.04.0'
}

params {
    samplesheet = null
    outdir      = 'results'

    // Filled from `terraform output` by the Makefile when using -profile awsbatch
    aws_region  = 'eu-west-2'
    batch_queue = null
    work_bucket = null
    alert_topic = null
}

process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: 'SAMTOOLS_.*' {
        container = 'staphb/samtools:1.21'
    }
    withName: 'CONCORDANCE|SUMMARISE' {
        // not -slim: Nextflow needs `ps` (procps) in the container for task metrics
        container = 'python:3.12'
    }
}

// Run evidence kept with every run: useful for cost and performance tuning.
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.tsv" }

profiles {
    // Laptop or CI runner with Docker.
    local {
        docker.enabled    = true
        // staphb images are amd64-only; emulate on Apple Silicon (harmless on x86)
        docker.runOptions = '--platform linux/amd64'
    }

    // Small public BAM from nf-core test-datasets. Used by nf-test and CI.
    test {
        docker.enabled     = true
        docker.runOptions  = '--platform linux/amd64'
        params.samplesheet = "${projectDir}/assets/samplesheet.test.csv"
    }

    // AWS Batch, built by infra/envs/dev.
    awsbatch {
        process.executor = 'awsbatch'
        process.queue    = params.batch_queue
        workDir          = "s3://${params.work_bucket}/work"
        aws {
            region = params.aws_region
            batch {
                cliPath          = '/opt/miniforge/bin/aws' // installed by the launch template
                maxSpotAttempts  = 3                        // retry Spot interruptions before failing
                maxParallelTransfers = 8
            }
            client {
                storageEncryption = 'aws:kms'               // matches the bucket default key
            }
        }
    }

    // On-prem: the Talos Kubernetes cluster in the home lab.
    // Needs a ReadWriteMany PVC called nextflow-work (e.g. NFS or Ceph).
    homelab {
        process.executor = 'k8s'
        k8s {
            namespace        = 'nextflow'
            storageClaimName = 'nextflow-work'
            storageMountPath = '/workspace'
        }
        workDir = '/workspace/work'
    }
}
